# Control-plane environment — copy to .env and adjust. Never commit .env.
# Every variable is prefixed UAB_ and read by uab_platform.config.Settings.

# development | test | staging | production
UAB_ENVIRONMENT=development
UAB_LOG_LEVEL=INFO

# --- Database -----------------------------------------------------------------
# SQLAlchemy URL using the psycopg (v3) driver.
# Local dev default matches docker-compose.dev.yml / scripts/dev_db.py output.
UAB_DATABASE_URL=postgresql+psycopg://uab:uab@127.0.0.1:5432/uab
UAB_DB_POOL_SIZE=5
UAB_DB_MAX_OVERFLOW=10

# --- Auth ---------------------------------------------------------------------
# REQUIRED in production (>=32 chars, random). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
UAB_JWT_SECRET=dev-only-insecure-jwt-secret-change-me
UAB_ACCESS_TOKEN_TTL_SECONDS=900
UAB_REFRESH_TOKEN_TTL_SECONDS=2592000
# First-run bootstrap is always allowed (when the users table is empty, the first
# registration becomes the owner of a personal workspace). Registration for
# additional users stays closed unless you open it here.
UAB_ALLOW_OPEN_REGISTRATION=false

# --- AI provider policy (cost policy: LOCAL -> ELIGIBLE FREE-TIER -> PAID) ----
UAB_ALLOW_LOCAL_PROVIDERS=true
UAB_ALLOW_FREE_TIER_PROVIDERS=true
# Paid providers stay DISABLED until you explicitly authorize them.
UAB_ALLOW_PAID_PROVIDERS=false
UAB_OLLAMA_BASE_URL=http://127.0.0.1:11434
